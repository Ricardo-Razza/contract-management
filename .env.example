# Configurações do Banco de Dados
# -------------------------------------------------------------
# Opção 1: MySQL (Padrão local)
DB_URL=jdbc:mysql://localhost:3306/contract_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8&zeroDateTimeBehavior=convertToNull
DB_USERNAME=seu_usuario_aqui
DB_PASSWORD=sua_senha_aqui
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Opção 2: PostgreSQL (Ex: Render / Supabase / Produção)
# DB_URL=jdbc:postgresql://<HOST_DO_BANCO>:5432/<NOME_DO_BANCO>?sslmode=require
# DB_USERNAME=seu_usuario_aqui
# DB_PASSWORD=sua_senha_aqui
# DB_DRIVER=org.postgresql.Driver

# -------------------------------------------------------------
# Configurações do Servidor e Aplicação
# -------------------------------------------------------------
PORT=8081
JPA_DDL_AUTO=update
SHOW_SQL=true
LOG_LEVEL=DEBUG
